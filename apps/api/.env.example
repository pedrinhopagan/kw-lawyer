PORT=1996
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:6795/lawyer_dev
# Gate de usuário e senha na frente do app. Sem as duas o gate fica desligado;
# em produção a API não sobe sem elas.
# ACCESS_USER=
# ACCESS_PASSWORD=
# OBSERVABILITY_DB_PATH=./data/observability.db
# DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# APP_BASE_URL=http://localhost:1995
# Integração com o Google Agenda (as três precisam estar setadas para o envio ligar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Chave dedicada de cifra dos tokens do Google (>= 32 caracteres).
# Trocar esta chave torna ilegíveis os tokens já gravados: a conta precisa ser reconectada.
# TOKEN_ENCRYPTION_KEY=
